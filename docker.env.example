# Copy to .env (git-ignored) for `docker compose up`. Unset values fall back to
# the defaults in docker-compose.yml.

# Database
DB_USER=postgres
DB_PASS=postgres
DB_NAME=finder

# Host ports
FE_PUBLISH_PORT=3000
BE_PUBLISH_PORT=3001
DB_PUBLISH_PORT=5432

# Backend
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
RECAPTCHA_SECRET_KEY=

# Cloudflare R2 (profile pictures)
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Frontend (baked in at image build time — rebuild after changing)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_R2_BASE_URL=
