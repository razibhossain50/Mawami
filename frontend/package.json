{
  "name": "mawami",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${FE_PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scripts:migrate-logs": "node scripts/migrate-logs.js",
    "test:api": "node scripts/api-smoke-test.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:biodata": "jest --testPathPattern=biodata",
    "test:frontend": "jest tests/",
    "test:components": "jest tests/step-indicator.test.tsx",
    "test:hooks": "jest tests/use-step-form.test.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@hookform/resolvers": "^5.0.1",
    "@internationalized/date": "^3.9.0",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@tanstack/react-query": "^5.80.2",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.4",
    "react-image-crop": "^11.0.10",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-image-crop": "^8.1.6",
    "@types/react-transition-group": "^4.4.12",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "husky": "^9.1.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "ts-jest": "^29.4.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/.next/",
      "<rootDir>/node_modules/",
      "<rootDir>/tests/.*\\.e2e\\.spec\\."
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx"
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
